{
  "name": "kv-batch-sync",
  "displayName": "Kv Batch Sync",
  "description": "Inventory batch synchronisation helpers.",
  "version": "0.4.1",
  "publisher": "kv-internal",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onFileSystem:kvsrc"
  ],
  "contributes": {
    "commands": [
      {
        "command": "kvsync.open",
        "title": "Kv: Open Batch Session"
      },
      {
        "command": "kvsync.attach",
        "title": "Kv: Attach Batch Session"
      },
      {
        "command": "kvsync.mark",
        "title": "Kv: Mark Batch Cell"
      },
      {
        "command": "kvsync.toggle",
        "title": "Kv: Toggle Preview"
      },
      {
        "command": "kvsync.pass",
        "title": "Kv: Skip Batch"
      },
      {
        "command": "kvsync.offerDraw",
        "title": "Kv: Propose Merge"
      },
      {
        "command": "kvsync.acceptDraw",
        "title": "Kv: Accept Merge"
      },
      {
        "command": "kvsync.rematch",
        "title": "Kv: Rerun Batch"
      },
      {
        "command": "kvsync.acceptRematch",
        "title": "Kv: Accept Rerun"
      },
      {
        "command": "kvsync.resign",
        "title": "Kv: Abort Batch"
      },
      {
        "command": "kvsync.copyKey",
        "title": "Kv: Copy Session Key"
      },
      {
        "command": "kvsync.close",
        "title": "Kv: Close Batch Session"
      },
      {
        "command": "kvsync.menu",
        "title": "Kv: Batch Menu"
      }
    ],
    "keybindings": [
      {
        "command": "kvsync.mark",
        "key": "space",
        "when": "editorTextFocus && resourceScheme == kvsrc"
      },
      {
        "command": "kvsync.mark",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus && resourceScheme == kvsrc"
      },
      {
        "command": "kvsync.toggle",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h"
      }
    ],
    "configuration": {
      "title": "Kv Batch Sync",
      "properties": {
        "kvsync.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:8787",
          "description": "Sync relay endpoint."
        },
        "kvsync.author": {
          "type": "string",
          "default": "dev-team",
          "description": "Author name shown for upstream changes."
        },
        "kvsync.colors.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Colour the board squares and pieces."
        },
        "kvsync.colors.darkSquare": {
          "type": "string",
          "default": "rgba(128, 128, 128, 0.18)",
          "description": "Background of dark squares (CSS colour)."
        },
        "kvsync.colors.whitePiece": {
          "type": "string",
          "default": "#e5c07b",
          "description": "Text colour of White pieces (CSS colour)."
        },
        "kvsync.colors.blackPiece": {
          "type": "string",
          "default": "#61afef",
          "description": "Text colour of Black pieces (CSS colour)."
        },
        "kvsync.colors.blackStone": {
          "type": "string",
          "default": "#e06c75",
          "description": "Text colour of Black go stones, the 1s (CSS colour)."
        },
        "kvsync.colors.whiteStone": {
          "type": "string",
          "default": "#e5c07b",
          "description": "Text colour of White go stones, the 0s (CSS colour)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "package": "vsce package --allow-missing-repository --skip-license"
  },
  "dependencies": {
    "@weshell/xiangqi.js": "1.0.3",
    "chess.js": "^1.4.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.18.2",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^7.0.2"
  }
}
